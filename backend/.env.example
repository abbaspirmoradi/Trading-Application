PORT=4000
# Local mongod, or a MongoDB Atlas SRV string. Always include a database name
# before the query string, otherwise Mongoose silently uses "test":
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/trading_app?retryWrites=true&w=majority
# Never commit a real connection string — it is a credential.
MONGO_URI=mongodb://127.0.0.1:27017/trading_app
# synthetic | yahoo   (synthetic is fully offline and deterministic per ticker)
# NOTE: only price/volume can ever be real. Fundamentals, options, news and macro
# are generated locally on either setting — see README > Data provenance.
MARKET_DATA_PROVIDER=synthetic
# When live data is requested and a fetch fails: false = error out (safe default),
# true = fall back to generated prices, flagged as degraded.
ALLOW_SYNTHETIC_FALLBACK=false

# memory | kafka
EVENT_BUS=memory
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=trading-agents
# Signing key for session tokens. Optional in development (a stable per-machine
# value is derived); MANDATORY in production — the server refuses to start
# without it. Generate with: openssl rand -hex 32
# JWT_SECRET=

# Risk policy
MAX_RISK_PER_TRADE_PCT=1.0
HARD_MAX_POSITION_PCT=5.0
MAX_PORTFOLIO_HEAT_PCT=6.0
KELLY_FRACTION=0.25
