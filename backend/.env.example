PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/trading_app
# synthetic | yahoo   (synthetic is fully offline and deterministic per ticker)
# NOTE: only price/volume can ever be real. Fundamentals, options, news and macro
# are generated locally on either setting — see README > Data provenance.
MARKET_DATA_PROVIDER=synthetic
# When live data is requested and a fetch fails: false = error out (safe default),
# true = fall back to generated prices, flagged as degraded.
ALLOW_SYNTHETIC_FALLBACK=false

# memory | kafka
EVENT_BUS=memory
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=trading-agents
# Risk policy
MAX_RISK_PER_TRADE_PCT=1.0
HARD_MAX_POSITION_PCT=5.0
MAX_PORTFOLIO_HEAT_PCT=6.0
KELLY_FRACTION=0.25
